# Copy this file to .env (for local use) and fill in real values.
# .env is git-ignored, so your keys never get committed.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same Supabase URL, but the SERVICE ROLE key (also in Project settings -> API).
# Only used by the ingestion script (scripts/ingest.ts), never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used as the contact email in the User-Agent header for both ingestion scripts
# (SEC EDGAR requires this; EQS News doesn't require it but it's good practice).
CONTACT_EMAIL=
