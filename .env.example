# Copy this file to .env (for local use) and fill in real values.
# .env is git-ignored, so your keys never get committed.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same Supabase URL, but the SERVICE ROLE key (also in Project settings -> API).
# Used by the ingestion scripts and server-side only by the web app (Stripe webhook,
# contract forms, homepage/dashboard insider stats behind RLS) — never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used as the contact email in the User-Agent header for both ingestion scripts
# (SEC EDGAR requires this; EQS News doesn't require it but it's good practice).
CONTACT_EMAIL=

# Stripe (Dashboard -> Developers -> API keys). Use sandbox/test keys for local dev.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the webhook endpoint's signing secret in the Dashboard for deployed environments.
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe Checkout success/cancel URLs; defaults to localhost if unset.
NEXT_PUBLIC_SITE_URL=

# EODHD (eodhd.com) API token for the daily stock analysis (scripts/ingest-analysis.ts):
# prices, fundamentals and analyst consensus for S&P 500, Nasdaq-100 and STOXX 600.
# Needs a paid plan with fundamentals ("Fundamentals Data Feed" or "All-In-One").
EODHD_API_TOKEN=
# Optional: EODHD index symbol used for the STOXX Europe 600 constituents.
STOXX600_INDEX_SYMBOL=SXXP.INDX
